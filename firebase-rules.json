{
  "rules": {
    "v2Users": {
      ".read": "auth != null && auth.token.email.toLowerCase() === 'cyxigion04012@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.token.email.toLowerCase() === 'cyxigion04012@gmail.com' || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending'))"
      }
    },
    "v2Usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "$name.matches(/^[a-z0-9_-]{3,20}$/) && newData.hasChildren(['uid', 'email'])"
      }
    },
    "$other": {
      ".read": "auth != null && (auth.token.email.toLowerCase() === 'cyxigion04012@gmail.com' || root.child('v2Users').child(auth.uid).child('status').val() === 'approved')",
      ".write": "auth != null && (auth.token.email.toLowerCase() === 'cyxigion04012@gmail.com' || root.child('v2Users').child(auth.uid).child('status').val() === 'approved')"
    }
  }
}
